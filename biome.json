{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "packages/typescript/**",
      "editors/vscode/**",
      "docs/app/**",
      "docs/components/**",
      "docs/lib/**",
      "docs/test/**",
      "docs/scripts/**",
      "scripts/**/*.ts",
      "usage/*/api.ts",
      "usage/*/init.ts",
      "usage/*/index.ts",
      "usage/*/test/**",
      "biome.json",
      "!**/node_modules",
      "!**/dist",
      "!**/*.tmLanguage.json",
      "!editors/vscode/snippets",
      "!editors/vscode/schemas",
      "!packages/typescript/README.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "noDescendingSpecificity": "off",
        "noHeadElement": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off",
        "noConfusingVoidType": "off",
        "useIterableCallbackReturn": "off",
        "noAssignInExpressions": "off",
        "noEmptyInterface": "off"
      },
      "complexity": {
        "noForEach": "off",
        "noBannedTypes": "off",
        "noCommaOperator": "off",
        "useLiteralKeys": "off",
        "noImportantStyles": "off"
      },
      "a11y": {
        "useSemanticElements": "off",
        "noSvgWithoutTitle": "off",
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "correctness": {
        "noComponentHookFactories": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
