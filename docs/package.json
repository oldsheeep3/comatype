{
  "name": "comatype-docs",
  "private": true,
  "type": "module",
  "description": "Comatype の仕様書（Next.js の静的エクスポート + React + TypeScript。コードのエディタは Monaco）",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "serve": "node scripts/serve.mjs",
    "gen:status": "node scripts/gen-status.mjs"
  },
  "dependencies": {
    "@shikijs/monaco": "^2.5.0",
    "@shikijs/rehype": "^2.5.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-to-string": "^4.0.0",
    "minisearch": "^7.2.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^2.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/hast": "^3.0.4",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9"
  }
}
