{
  "import": {
    "prefix": "import",
    "body": [
      "import ${1:UserData} from ${2:../types/UserData.comat}"
    ],
    "description": "Import a type from another file"
  },
  "type": {
    "prefix": "type",
    "body": [
      "${1:UserData} {",
      "\t${2:name}: ${3|string,bool,int,email,phone,uuid,uuidv4,uuidv7,date,datetime,time,int64,decimal,url,bytes,json|},",
      "}"
    ],
    "description": "Declare a type"
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Role} {",
      "\t${2:admin},",
      "\t${3:member},",
      "}"
    ],
    "description": "enum"
  },
  "params": {
    "prefix": "params",
    "body": [
      "params {",
      "\t${1:id}: ${2:uuidv4},",
      "}"
    ],
    "description": "Path parameters (match the [id] directory or file name)"
  },
  "search": {
    "prefix": "search",
    "body": [
      "search {",
      "\t${1:limit}?: ${2:int},",
      "}"
    ],
    "description": "Query string"
  },
  "body": {
    "prefix": "body",
    "body": [
      "body ${1:UserData}"
    ],
    "description": "Request body (one per endpoint)"
  },
  "body-inline": {
    "prefix": "bodyo",
    "body": [
      "body {",
      "\t${1:name}: ${2:string},",
      "}"
    ],
    "description": "Request body (written inline)"
  },
  "s200-headers": {
    "prefix": "sheaders",
    "body": [
      "s${1:200} ${2:none}, {",
      "\t${3:Allow}: ${4:string[]},",
      "}"
    ],
    "description": "Status with response headers (sNNN <type>, { ... })"
  },
  "path": {
    "prefix": "path",
    "body": [
      "path ${1|/,./|}${2:fix/path}"
    ],
    "description": "Explicit path (/ is fixed, ./ is relative to the directory; deprecated)"
  },
  "wrap": {
    "prefix": "wrap",
    "body": [
      "wrap ${1:auth}"
    ],
    "description": "Enable a wrapper"
  },
  "wrap-off": {
    "prefix": "wrapoff",
    "body": [
      "wrap ${1:auth} off"
    ],
    "description": "Disable a wrapper"
  },
  "cookie": {
    "prefix": "cookie",
    "body": [
      "cookie ${1|on,off|}"
    ],
    "description": "Send and receive cookies / do not"
  },
  "cache": {
    "prefix": "cache",
    "body": [
      "cache ${1|off,60000,60000 cookie|}"
    ],
    "description": "Cache of GET / QUERY responses (off / ttl in ms / ttl in ms cookie)"
  },
  "header": {
    "prefix": "header",
    "body": [
      "${1|header,headerReq,headerRes|} {",
      "\t\"${2:X-Request-Id}\"?: ${3:uuid},",
      "}"
    ],
    "description": "Headers (header: both, headerReq: request, headerRes: response)"
  },
  "init": {
    "prefix": "init",
    "body": [
      "baseUrl ${1:https://api.example.com}",
      "",
      "cookie ${2:session} {",
      "\thttpOnly: true,",
      "\tsecure: true,",
      "\tsameSite: lax,",
      "}",
      "",
      "wrapper ${3:auth} {",
      "\tctx {",
      "\t\t${4:user}: ${5:UserData},",
      "\t}",
      "\ts401 ${6:ApiError}",
      "}"
    ],
    "description": "Template of init.comat"
  },
  "wrapper": {
    "prefix": "wrapper",
    "body": [
      "wrapper ${1:auth} {",
      "\tctx {",
      "\t\t${2:user}: ${3:UserData},",
      "\t}",
      "\ts401 ${4:ApiError}",
      "}"
    ],
    "description": "Wrapper declaration (init.comat)"
  }
}
