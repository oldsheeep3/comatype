{
  "import": {
    "prefix": "import",
    "body": [
      "import ${1:UserData} from ${2:../types/UserData.comat}"
    ],
    "description": "型を別のファイルから import する"
  },
  "type": {
    "prefix": "type",
    "body": [
      "${1:UserData} {",
      "\t${2:name}: ${3|string,bool,int,email,phone,uuid,uuidv4,uuidv7,date,datetime,time,int64,decimal,url,bytes,json|},",
      "}"
    ],
    "description": "型の宣言"
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Role} {",
      "\t${2:admin},",
      "\t${3:member},",
      "}"
    ],
    "description": "enum"
  },
  "params": {
    "prefix": "params",
    "body": [
      "params {",
      "\t${1:id}: ${2:uuidv4},",
      "}"
    ],
    "description": "path パラメータ（__id のファイル名に対応）"
  },
  "search": {
    "prefix": "search",
    "body": [
      "search {",
      "\t${1:limit}?: ${2:int},",
      "}"
    ],
    "description": "クエリ文字列"
  },
  "body": {
    "prefix": "body",
    "body": [
      "body ${1:UserData}"
    ],
    "description": "リクエストのボディ（エンドポイントに 1 つ）"
  },
  "body-inline": {
    "prefix": "bodyo",
    "body": [
      "body {",
      "\t${1:name}: ${2:string},",
      "}"
    ],
    "description": "リクエストのボディ（その場で書く）"
  },
  "s200-headers": {
    "prefix": "sheaders",
    "body": [
      "s${1:200} ${2:none}, {",
      "\t${3:Allow}: ${4:string[]},",
      "}"
    ],
    "description": "レスポンスヘッダつきのステータス（sNNN <型>, { ... }）"
  },
  "path": {
    "prefix": "path",
    "body": [
      "path ${1|/,./|}${2:fix/path}"
    ],
    "description": "path の明示（/ は固定、./ はディレクトリからの相対。非推奨）"
  },
  "wrap": {
    "prefix": "wrap",
    "body": [
      "wrap ${1:auth}"
    ],
    "description": "ラッパーを有効にする"
  },
  "wrap-off": {
    "prefix": "wrapoff",
    "body": [
      "wrap ${1:auth} off"
    ],
    "description": "ラッパーを無効にする"
  },
  "cookie": {
    "prefix": "cookie",
    "body": [
      "cookie ${1|on,off|}"
    ],
    "description": "cookie を送受信する / しない"
  },
  "cache": {
    "prefix": "cache",
    "body": [
      "cache ${1|off,60000,60000 cookie|}"
    ],
    "description": "GET / QUERY のレスポンスのキャッシュ（off / ttl ミリ秒 / ttl ミリ秒 cookie）"
  },
  "header": {
    "prefix": "header",
    "body": [
      "${1|header,headerReq,headerRes|} {",
      "\t\"${2:X-Request-Id}\"?: ${3:uuid},",
      "}"
    ],
    "description": "ヘッダ（header: 両方、headerReq: リクエスト、headerRes: レスポンス）"
  },
  "init": {
    "prefix": "init",
    "body": [
      "baseUrl ${1:https://api.example.com}",
      "",
      "cookie ${2:session} {",
      "\thttpOnly: true,",
      "\tsecure: true,",
      "\tsameSite: lax,",
      "}",
      "",
      "wrapper ${3:auth} {",
      "\tctx {",
      "\t\t${4:user}: ${5:UserData},",
      "\t}",
      "\ts401 ${6:ApiError}",
      "}"
    ],
    "description": "init.comat の雛形"
  },
  "wrapper": {
    "prefix": "wrapper",
    "body": [
      "wrapper ${1:auth} {",
      "\tctx {",
      "\t\t${2:user}: ${3:UserData},",
      "\t}",
      "\ts401 ${4:ApiError}",
      "}"
    ],
    "description": "ラッパーの宣言（init.comat）"
  }
}
