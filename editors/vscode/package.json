{
  "name": "comatype",
  "displayName": "Comatype",
  "description": "Language support for Comatype .comat API definitions: live diagnostics, go to definition, hover, completion, outline, syntax highlighting, snippets, code generation and OpenAPI export/import",
  "version": "0.0.2",
  "publisher": "comatype",
  "license": "MIT",
  "homepage": "https://comatype.sheeplab.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/oldsheeep3/comatype.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/oldsheeep3/comatype/issues"
  },
  "icon": "images/icon.png",
  "keywords": [
    "comatype",
    "comat",
    "api",
    "openapi",
    "code generation",
    "language server",
    "typescript",
    "go",
    "python",
    "rust",
    "kotlin",
    "swift",
    "ruby",
    "java"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "engines": {
    "vscode": "^1.82.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:comat",
    "workspaceContains:**/comatype.config.json",
    "onCommand:comatype.exportOpenApi",
    "onCommand:comatype.importOpenApi",
    "onCommand:comatype.showStatusCodes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "comat",
        "aliases": [
          "Comatype",
          "comat"
        ],
        "extensions": [
          ".comat"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "comat",
        "scopeName": "source.comat",
        "path": "./syntaxes/comat.tmLanguage.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "comatype.config.json",
        "url": "./schemas/comatype.config.schema.json"
      }
    ],
    "snippets": [
      {
        "language": "comat",
        "path": "./snippets/comat.json"
      },
      {
        "language": "comat",
        "path": "./snippets/status.json"
      }
    ],
    "commands": [
      {
        "command": "comatype.check",
        "title": "Comatype: Check (comatype check)"
      },
      {
        "command": "comatype.generate",
        "title": "Comatype: Generate (comatype generate)"
      },
      {
        "command": "comatype.restartServer",
        "title": "Comatype: Restart Language Server"
      },
      {
        "command": "comatype.exportOpenApi",
        "title": "Comatype: Export OpenAPI (comat → openapi.yml)"
      },
      {
        "command": "comatype.importOpenApi",
        "title": "Comatype: Import OpenAPI (openapi.yml → comat)"
      },
      {
        "command": "comatype.showStatusCodes",
        "title": "Comatype: Show Status Codes"
      }
    ],
    "configuration": {
      "title": "Comatype",
      "properties": {
        "comatype.path": {
          "type": "string",
          "default": "comatype",
          "description": "Path to the comatype executable. Set it when comatype is not on PATH."
        },
        "comatype.config": {
          "type": "string",
          "default": "",
          "description": "Location of comatype.config.json, relative to the workspace folder. When empty, it is searched for upwards from the open file."
        },
        "comatype.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Only when the language server is off: run comatype check when a .comat file is opened or saved and show the result as diagnostics."
        },
        "comatype.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use the language server (comatype lsp) for diagnostics while typing, go to definition, hover, completion and outline. When off, comatype check runs on save instead."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "esbuild extension.js --bundle --platform=node --format=cjs --target=node18 --external:vscode --minify --outfile=dist/extension.js",
    "vscode:prepublish": "pnpm run build",
    "package": "vsce package --no-dependencies",
    "pretest": "pnpm run build"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
