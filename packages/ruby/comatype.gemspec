Gem::Specification.new do |s|
  s.name = "comatype"
  s.version = "0.0.1"
  s.summary = "Comatype runtime for Ruby (client C and server S)"
  s.description = "Runtime for Ruby code generated by Comatype: types, validation, an HTTP client and a Rack-compatible server."
  s.license = "MIT"
  s.authors = ["oldsheeep3"]
  s.homepage = "https://github.com/oldsheeep3/comatype"
  s.metadata = {
    "source_code_uri" => "https://github.com/oldsheeep3/comatype/tree/main/packages/ruby",
    "bug_tracker_uri" => "https://github.com/oldsheeep3/comatype/issues",
    "rubygems_mfa_required" => "true"
  }
  s.required_ruby_version = ">= 3.1"
  s.files = Dir["lib/**/*.rb"] + ["README.md"]
  s.require_paths = ["lib"]
end
