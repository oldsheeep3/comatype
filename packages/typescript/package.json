{
  "name": "@comatype/typescript",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "description": "Comatype runtime for TypeScript (client `c` and server `s`)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldsheeep3/comatype.git",
    "directory": "packages/typescript"
  },
  "homepage": "https://github.com/oldsheeep3/comatype#readme",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    }
  }
}
