{
  "name": "@comatype/javascript",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "description": "Comatype runtime for JavaScript (client `c` and server `s`)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldsheeep3/comatype.git",
    "directory": "packages/javascript"
  },
  "homepage": "https://github.com/oldsheeep3/comatype#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
